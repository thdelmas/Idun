<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Bios companion writes + reads. Mirrors Smokeless's manifest pattern. -->
    <uses-permission android:name="com.bios.app.permission.WRITE_COMPANION" />
    <uses-permission android:name="com.bios.app.permission.READ_HEALTH" />

    <!-- Meal reminders: post notifications (33+), exact alarms, re-arm on boot. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <queries>
        <package android:name="com.bios.app" />
        <provider android:authorities="com.bios.app.health" />
    </queries>

    <application
        android:name=".IdunApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Idun"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".RecipeDetailActivity"
            android:label="@string/recipe_detail_title"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".ShoppingListActivity"
            android:label="@string/shopping_list_title" />

        <activity
            android:name=".SettingsActivity"
            android:label="@string/settings_title"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".PlanningActivity"
            android:label="@string/planning_title" />

        <activity
            android:name=".RoutineActivity"
            android:label="@string/routines_title"
            android:parentActivityName=".PlanningActivity" />

        <activity
            android:name=".PickRecipeActivity"
            android:label="@string/pick_recipe_title"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".CreditsActivity"
            android:label="@string/credits_title"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".LearnActivity"
            android:label="@string/learn_title" />

        <activity
            android:name=".FoodDetailActivity"
            android:parentActivityName=".LearnActivity" />

        <receiver
            android:name=".reminders.MealReminderReceiver"
            android:exported="false" />

        <receiver
            android:name=".reminders.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
