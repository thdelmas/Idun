<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
        Cockpit dark — kin to W2F's instrument panel. Deep navy surfaces,
        light text, apple-red and Norse-gold reserved for accents (FAB,
        step circles, section stripes, today badge).
    -->
    <style name="Base.Theme.Idun" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Primary — apple red. -->
        <item name="colorPrimary">@color/accent_apple_red</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/accent_apple_red_soft</item>
        <item name="colorOnPrimaryContainer">@color/accent_apple_red_dark</item>

        <!-- Secondary — Norse gold. -->
        <item name="colorSecondary">@color/accent_norse_gold</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="colorSecondaryContainer">@color/accent_norse_gold_soft</item>
        <item name="colorOnSecondaryContainer">@color/accent_norse_gold_dark</item>

        <!-- Surface — cockpit navy. -->
        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/background</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/divider</item>
        <item name="colorOutlineVariant">@color/divider</item>

        <!-- Status bar matches the cockpit surface; light icons on dark bar. -->
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.Idun" parent="Base.Theme.Idun" />
</resources>
