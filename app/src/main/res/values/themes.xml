<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
        Locked to Light: the parchment / apple / gold aesthetic doesn't
        translate to dark mode without rethinking the palette. Dark
        support is deferred to v2.
    -->
    <style name="Base.Theme.Idun" parent="Theme.Material3.Light.NoActionBar">
        <!-- Primary — apple red, used for toolbars, the FAB, step circles, etc. -->
        <item name="colorPrimary">@color/accent_apple_red</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/accent_apple_red_soft</item>
        <item name="colorOnPrimaryContainer">@color/accent_apple_red_dark</item>

        <!-- Secondary — Norse gold, used for tonal buttons, section stripes. -->
        <item name="colorSecondary">@color/accent_norse_gold</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="colorSecondaryContainer">@color/accent_norse_gold_soft</item>
        <item name="colorOnSecondaryContainer">@color/accent_norse_gold_dark</item>

        <!-- Surface — parchment. -->
        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/background</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/divider</item>
        <item name="colorOutlineVariant">@color/divider</item>

        <!-- Status bar matches the apple-red toolbar. -->
        <item name="android:statusBarColor">@color/accent_apple_red</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- All MaterialToolbars in the app get the apple-red background. -->
        <item name="toolbarStyle">@style/Widget.Idun.Toolbar</item>
    </style>

    <style name="Widget.Idun.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">?attr/colorPrimary</item>
        <item name="titleTextColor">?attr/colorOnPrimary</item>
        <item name="subtitleTextColor">?attr/colorOnPrimary</item>
        <item name="navigationIconTint">?attr/colorOnPrimary</item>
        <item name="materialThemeOverlay">@style/ThemeOverlay.Idun.Toolbar</item>
    </style>

    <!--
        Forces icon tint + action menu text in the toolbar onto the primary
        surface so the search icon and overflow dots are visible against the
        apple-red background.
    -->
    <style name="ThemeOverlay.Idun.Toolbar" parent="ThemeOverlay.Material3.Dark.ActionBar">
        <item name="colorControlNormal">?attr/colorOnPrimary</item>
        <item name="actionMenuTextColor">?attr/colorOnPrimary</item>
    </style>

    <style name="Theme.Idun" parent="Base.Theme.Idun" />
</resources>
