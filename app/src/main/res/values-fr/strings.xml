    <string name="credits_title">Crédits</string>
    <string name="credits_intro">Les recettes d\'Idun reflètent le travail publié publiquement par deux chercheurs. Leurs sites, chaînes et fondations sont ici pour que tu puisses les consulter directement.</string>
    <string name="credits_johnson_name">Bryan Johnson</string>
    <string name="credits_johnson_role">Fondateur · Protocole Blueprint</string>
    <string name="credits_johnson_bio">Entrepreneur américain à la tête de Blueprint, un protocole de longévité open source qu\'il teste sur lui-même. Ses repas quotidiens — Super Veggie, Nutty Pudding, Longevity Mix — forment la base du corpus de recettes Blueprint d\'Idun.</string>
    <string name="credits_johnson_link_protocol">Protocole Blueprint</string>
    <string name="credits_johnson_link_website">bryanjohnson.com</string>
    <string name="credits_johnson_link_youtube">YouTube</string>
    <string name="credits_johnson_link_x">X / Twitter</string>
    <string name="credits_longo_name">Dr. Valter Longo</string>
    <string name="credits_longo_role">Biogérontologue · USC Longevity Institute</string>
    <string name="credits_longo_bio">Biogérontologue italo-américain, directeur du USC Longevity Institute. Son Régime de longévité — un schéma pesco-méditerranéen à dominante végétale couplé à une fenêtre alimentaire quotidienne — ancre le corpus de recettes Longo d\'Idun.</string>
    <string name="credits_longo_link_website">valterlongo.com</string>
    <string name="credits_longo_link_foundation">Create Cures Foundation</string>
    <string name="credits_longo_link_institute">USC Longevity Institute</string>
    <string name="credits_disclaimer">Idun est un projet indépendant, sans affiliation ni approbation d\'aucun des deux chercheurs.</string>
